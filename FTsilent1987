local buttonDragging = false
local buttonWasDragged = false
local buttonDragStart, buttonStartPos
local currentButtonInput

local function updateButtonDrag(input)
	local delta = input.Position - buttonDragStart
	if delta.Magnitude > 8 then
		buttonWasDragged = true
	end
	local newPos = UDim2.new(
		buttonStartPos.X.Scale,
		buttonStartPos.X.Offset + delta.X,
		buttonStartPos.Y.Scale,
		buttonStartPos.Y.Offset + delta.Y
	)
	toggleButton.Position = toggleButton.Position:Lerp(newPos, 0.35)
end

toggleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		buttonDragging = true
		buttonWasDragged = false
		buttonDragStart = input.Position
		buttonStartPos = toggleButton.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				buttonDragging = false
			end
		end)
	end
end)

toggleButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		currentButtonInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == currentButtonInput and buttonDragging then
		updateButtonDrag(input)
	end
end)

