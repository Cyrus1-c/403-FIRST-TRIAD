local folkenstein______ = nil

local function getRoot(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHead(char)
	return char and char:FindFirstChild("Head")
end

local function getHum(char)
	return char and char:FindFirstChildOfClass("Humanoid")
end

-- despite the name, this returns TRUE when the player should be EXCLUDED
local function isTeammate(plr)
	if config.SA2_TeamTarget == "All" then
		return false
	end
	if not plr.Team or not LocalPlayer.Team then
		return false
	end
	local same = (plr.Team == LocalPlayer.Team) or (plr.TeamColor == LocalPlayer.TeamColor)
	if config.SA2_TeamTarget == "Enemies" then
		return same
	end
	if config.SA2_TeamTarget == "Teams" then
		return not same
	end
	return false
end

local function predictthatpos(targetPart)
	if not targetPart or not targetPart.Parent then
		return targetPart and targetPart.Position or nil
	end
	local predTime = tonumber(config.SA2_Prediction) or 0
	if predTime <= 0 then
		return targetPart.Position
	end
	local ok, vel = pcall(function()
		return targetPart.Velocity
	end)
	if not ok or not vel then
		vel = Vector3.new(0, 0, 0)
	end
	local clampedTime = math.clamp(predTime, 0, 0.5)
	return targetPart.Position + (vel * clampedTime)
end

local function rollChance(chance)
	if chance == 100 then
		return true
	end
	if chance <= 0 then
		return false
	end
	return math.random(1, 100) <= chance
end

local function aimmethodsContains(name)
	for _, m in ipairs(config.SA2_AimMethods or {}) do
		if m == name then
			return true
		end
	end
	return false
end

local function raycastVisible(origin, targetPart)
	if not config.SA2_Wallcheck then
		return true
	end
	local dir = targetPart.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
	params.IgnoreWater = true
	local result = Workspace:Raycast(origin, dir, params)
	if not result then
		return true
	end
	return result.Instance and result.Instance:IsDescendantOf(targetPart.Parent)
end

local function getClosestTarget()
	local myChar = LocalPlayer.Character
	local myRoot = getRoot(myChar)
	if not myRoot or not Camera then
		return nil
	end
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local closest, shortest = nil, config.SA2_FovRadius
	local origin = Camera.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and not isTeammate(plr) then
			local hum = getHum(plr.Character)
			local part = nil

			if config.SA2_TargetPart == "Head" then
				part = getHead(plr.Character)
			elseif config.SA2_TargetPart == "HumanoidRootPart" then
				part = getRoot(plr.Character)
			elseif config.SA2_TargetPart == "Random" then
				if math.random(1, 100) <= config.SA2_HeadshotChance then
					part = getHead(plr.Character)
				else
					part = getRoot(plr.Character)
				end
			end

if not part then
				part = getHead(plr.Character) or getRoot(plr.Character)
			end

			if hum and hum.Health > 0 and part then
				local predicted = predictthatpos(part)
				local dist3D = (myRoot.Position - predicted).Magnitude

				if dist3D <= config.SA2_TargetRange then
					if config.SA2_ThreeSixtyMode then
						if raycastVisible(origin, part) then
							if dist3D < shortest then
								shortest = dist3D
								closest = part
							end
						end
					else
						local screenPos, onScreen = Camera:WorldToViewportPoint(predicted)
						if onScreen then
							local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
							if dist < shortest then
								if raycastVisible(origin, part) then
									shortest = dist
									closest = part
								end
							end
						end
					end
				end
			end
		end
	end

	return closest
end

-- ===== the actual silent aim: __namecall hook on Workspace:Raycast =====
local originalNamecall
originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
	if config.varibz.respawnLock or not config.SA2_Enabled then
		return originalNamecall(...)
	end

	local self = ...
	local method = getnamecallmethod()

	if method ~= "Raycast" then
		return originalNamecall(...)
	end
	if checkcaller() then
		return originalNamecall(...)
	end
	if not aimmethodsContains("Raycast") then
		return originalNamecall(...)
	end

	if not config.SA2_ThreeSixtyMode and not rollChance(config.SA2_HitChance) then
		config.SA2_FovIsTargeted = false
		return originalNamecall(...)
	end

	local HitPart = folkenstein______
	if not HitPart or not HitPart.Parent then
		config.SA2_FovIsTargeted = false
		return originalNamecall(...)
	end
	config.SA2_FovIsTargeted = true

	local targetPos = predictthatpos(HitPart)
	if not targetPos then
		return originalNamecall(...)
	end

	local Arguments = { ... }
	local Origin = Arguments[2]
	local Direction = Arguments[3]

	if typeof(Origin) ~= "Vector3" or typeof(Direction) ~= "Vector3" then
		return originalNamecall(...)
	end

	if config.SA2_Wallbang then
		-- skip the real world test entirely: return a synthetic hit on the target
		local toTarget = targetPos - Origin
		local distance = toTarget.Magnitude
		local normal = (Origin - targetPos).Unit
		local fakeResult = {
			Instance = HitPart,
			Position = targetPos,
			Normal = normal,
			Material = HitPart.Material or Enum.Material.Plastic,
			Distance = distance,
			Hit = true,
		}
		pcall(function()
			fakeResult.Origin = Origin
			fakeResult.Direction = Direction.Unit
		end)
		return fakeResult
	end

local newDir = (targetPos - Origin).Unit
	Arguments[3] = newDir * Direction.Magnitude
	return originalNamecall(unpack(Arguments))
end))

