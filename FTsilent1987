local function makeToggle(text, defaultOn, callback)
	local btn = makeButton(
		text .. (defaultOn and ": ON" or ": OFF"),
		defaultOn and Color3.fromRGB(75, 75, 88) or Color3.fromRGB(43, 43, 51),
		30
	)
	local state = defaultOn
	btn.Activated:Connect(function()
		state = not state
		btn.Text = text .. (state and ": ON" or ": OFF")
		btn.BackgroundColor3 = state and Color3.fromRGB(75, 75, 88) or Color3.fromRGB(43, 43, 51)
		callback(state)
	end)
	return btn
end

local function makeSlider(labelText, min, max, default, isInt, callback)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 42)
	wrap.BackgroundTransparency = 1
	wrap.ZIndex = 3
	wrap.Parent = contentScroll

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 16)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText .. ": " .. (isInt and math.floor(default) or string.format("%.2f", default))
	lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
	lbl.Font = Enum.Font.GothamSemibold
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 3
	lbl.Parent = wrap

	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 0, 6)
	bg.Position = UDim2.fromOffset(0, 22)
	bg.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
	bg.BorderSizePixel = 0
	bg.ZIndex = 3
	bg.Parent = wrap
	Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("TextButton")
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.Text = ""
	knob.ZIndex = 3
	knob.Parent = bg
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local dragging = false
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local mouseX = input.Position.X
			local absX = bg.AbsolutePosition.X
			local sizeX = bg.AbsoluteSize.X
			local rel = math.clamp((mouseX - absX) / sizeX, 0, 1)
			knob.Position = UDim2.new(rel, 0, 0.5, 0)

			local val = min + rel * (max - min)
			if isInt then
				val = math.floor(val)
				lbl.Text = labelText .. ": " .. val
			else
				lbl.Text = labelText .. ": " .. string.format("%.2f", val)
			end
			callback(val)
		end
	end)
	return wrap
end

