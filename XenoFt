local function setOpen(state)
  opened = state
  if state then
    root.Visible = true
    uiScale.Scale = baseScale * 0.92
    TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
      Scale = baseScale
    }):Play()
  else
    local t = TweenService:Create(uiScale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
      Scale = baseScale * 0.92
    })
    t:Play()
    t.Completed:Connect(function()
      if not opened then
        root.Visible = false
      end
    end)
  end
end

