local function loadConfig()
  if not (isfile and readfile) then
    return
  end
  local ok, raw = pcall(function()
    if isfile(CONFIG_FILE) then
      return readfile(CONFIG_FILE)
    end
  end)
  if not ok or type(raw) ~= "string" then
    return
  end
  local decoded, data = pcall(function()
    return HttpService:JSONDecode(raw)
  end)
  if not decoded or type(data) ~= "table" then
    return
  end
  if type(data.Toggles) == "table" then
    for key in pairs(Toggles) do
      if type(data.Toggles[key]) == "boolean" then
        Toggles[key] = data.Toggles[key]
      end
    end
  end
  if type(data.Values) == "table" then
    for _, key in ipairs({"FOV", "AimFOV", "AimSmooth", "FlySpeed"}) do
      local v = data.Values[key]
      if type(v) == "number" then
        local r = Ranges[key]
        Values[key] = math.clamp(v, r[1], r[2])
      end
    end
  end
  local validParts = {Head = true, HumanoidRootPart = true, UpperTorso = true}
  if validParts[data.TargetPart] then
    selectedTargetPart = data.TargetPart
  end
  if validParts[data.AimTargetPart] then
    aimTargetPart = data.AimTargetPart
  end
  if data.Device == "None" or data.Device == "PC" or data.Device == "Mobile" then
    selectedDevice = data.Device
  end
end

local function saveConfig()
  if not writefile then
    return
  end
  local ok, encoded = pcall(function()
    return HttpService:JSONEncode({
      Toggles = Toggles,
      Values = {FOV = Values.FOV, AimFOV = Values.AimFOV, AimSmooth = Values.AimSmooth, FlySpeed = Values.FlySpeed},
      TargetPart = selectedTargetPart,
      AimTargetPart = aimTargetPart,
      Device = selectedDevice
    })
  end)
  if ok and encoded ~= lastSaved then
    lastSaved = encoded
    pcall(writefile, CONFIG_FILE, encoded)
  end
end

