local function formatValue(key, v)
  if key == "Boost" then
    return string.format("%.1fx", v)
  end
  if key == "Target" and v <= 0 then
    return "Off"
  end
  if key == "FOV" or key == "AimFOV" then
    return math.floor(v + 0.5) .. "px"
  end
  if key == "AimSmooth" or key == "FlySpeed" then
    return tostring(math.floor(v + 0.5))
  end
  return math.floor(v + 0.5) .. "m"
end

local function formatNumber(n)
  local s = tostring(math.floor(n))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  return (out:gsub("^,", ""))
end

local function mask(name)
  local keep = math.min(3, #name)
  return string.sub(name, 1, keep) .. string.rep("*", math.max(#name - keep, 3))
end

local Sliders = {Target = {}, FOV = {}, AimFOV = {}, AimSmooth = {}, Parry = {}, Boost = {}, Hitbox = {}, FlySpeed = {}}
local ValueLabels = {Target = {}, FOV = {}, AimFOV = {}, AimSmooth = {}, Parry = {}, Boost = {}, Hitbox = {}, FlySpeed = {}}

local function setValue(key, v)
  Values[key] = v
  for _, s in ipairs(Sliders[key]) do
    s.Set(v)
  end
  for _, l in ipairs(ValueLabels[key]) do
    l.Text = formatValue(key, v)
  end
  if tabValue and selected == key then
    tabValue.Text = formatValue(key, v)
  end
end

local function makeSlider(parent, pos, size, key)
  local range = Ranges[key]
  local min, max, step = range[1], range[2], range[3]
  local hit = new("Frame", {
    Position = pos,
    Size = size,
    BackgroundTransparency = 1,
    Active = true
  }, parent)
  local track = new("Frame", {
    Position = UDim2.new(0, 0, 0.5, -2),
    Size = UDim2.new(1, 0, 0, 4),
    BackgroundColor3 = Theme.Track,
    BorderSizePixel = 0
  }, hit)
  round(track, 99)
  local fill = new("Frame", {
    Size = UDim2.new(0, 0, 1, 0),
    BackgroundColor3 = Theme.Accent,
    BorderSizePixel = 0
  }, track)
  round(fill, 99)
  local knob = new("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0, 0, 0.5, 0),
    Size = UDim2.fromOffset(14, 14),
    BackgroundColor3 = Color3.new(1, 1, 1),
    BorderSizePixel = 0,
    ZIndex = 3
  }, track)
  round(knob, 99)

  local object = {Hit = hit}

  function object.Set(value)
    local a = math.clamp((value - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(a, 0, 1, 0)
    knob.Position = UDim2.new(a, 0, 0.5, 0)
    local show = not (key == "Target" and value <= 0)
    knob.Visible = show
    fill.Visible = show
  end

  local dragging = false

  local function update(x)
    local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    local v = min + (max - min) * a
    v = math.floor(v / step + 0.5) * step
    setValue(key, v)
  end

  hit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
      dragging = true
      update(input.Position.X)
    end
  end)

  UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
      update(input.Position.X)
    end
  end)

  UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
      dragging = false
    end
  end)

  table.insert(Sliders[key], object)
  return object
end

