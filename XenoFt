local function target()
    if not Toggles.SilentAim then return nil end
    local fov = Values.FOV
    if fov <= 0 then return nil end

    local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)
    local best, bestDist = nil, math.huge
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local isTeammate = Toggles.TeamCheck and IsTeammate(plr)
            if not isTeammate then
                local char = plr.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local targetPart = char:FindFirstChild(selectedTargetPart) or char:FindFirstChild("Head")
                if targetPart and hum and hum.Health > 0 then
                    local sp, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d <= fov and d < bestDist then
                            local isVisible = true
                            if Toggles.WallCheck then
                                isVisible = WallCheck(char, targetPart)
                            end
                            if isVisible then
                                best, bestDist = plr, d
                            end
                        end
                    end
                end
            end
        end
    end
    if not best or not best.Character then return nil end
    local targetPart = best.Character:FindFirstChild(selectedTargetPart) or best.Character:FindFirstChild("Head")
    return targetPart and targetPart.Position or nil
end

local function aimTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local fov = Values.AimFOV
    if fov <= 0 then return nil end

    local center = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local bestPos, bestDist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local isTeammate = Toggles.TeamCheck and IsTeammate(plr)
            if not isTeammate then
                local char = plr.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local targetPart = char:FindFirstChild(aimTargetPart) or char:FindFirstChild("Head")
                if targetPart and hum and hum.Health > 0 then
                    local sp, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d <= fov and d < bestDist then
                            local isVisible = true
                            if Toggles.WallCheck then
                                isVisible = WallCheck(char, targetPart)
                            end
                            if isVisible then
                                bestPos, bestDist = targetPart.Position, d
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPos
end

local Hkiz; Hkiz = hookfunction(getRayDirections, newcclosure(function(originCFrame, count, spread, seed)
    local targetPos = target()
    if targetPos then
        local dir = targetPos - originCFrame.Position
        if dir.Magnitude > 0.001 then
            local unit = dir.Unit
            local out = table.create(count)
            for i = 1, count do out[i] = unit end
            return out
        end
    end
    return Hkiz(originCFrame, count, spread, seed)
end))

