local function IsTeammate(targetPlayer)
  if not targetPlayer then
    return false
  end

  local localCharacter = LocalPlayer.Character
  local targetCharacter = targetPlayer.Character

  if localCharacter and targetCharacter then
    local localMatch = localCharacter:GetAttribute("MatchId")
    local targetMatch = targetCharacter:GetAttribute("MatchId")

    if localMatch ~= nil or targetMatch ~= nil then
      local localTeam = localCharacter:GetAttribute("PvPTeam")
      local targetTeam = targetCharacter:GetAttribute("PvPTeam")
      return localMatch ~= nil
        and localMatch == targetMatch
        and localTeam ~= nil
        and targetTeam ~= nil
        and localTeam == targetTeam
    end
  end

  local localSide = LocalPlayer:GetAttribute("StageTeamSide")
  local targetSide = targetPlayer:GetAttribute("StageTeamSide")
  if typeof(localSide) == "number" and typeof(targetSide) == "number" then
    return localSide == targetSide
  end

  if LocalPlayer.Neutral or targetPlayer.Neutral then
    return false
  end

  return LocalPlayer.Team ~= nil and targetPlayer.Team == LocalPlayer.Team
end

local function WallCheck(character, targetPart)
  targetPart = targetPart or (character and character:FindFirstChild("Head"))
  if not character or not targetPart or not targetPart:IsDescendantOf(character) then
    return false
  end

  local cam = workspace.CurrentCamera
  if not cam then
    return false
  end

  local localCharacter = LocalPlayer.Character
  local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

  local filter = { cam }
  if localCharacter then
    table.insert(filter, localCharacter)
  end

  local params = RaycastParams.new()
  params.FilterDescendantsInstances = filter
  params.FilterType = Enum.RaycastFilterType.Exclude
  params.IgnoreWater = true

  local camOrigin = cam.CFrame.Position
  local camResult = workspace:Raycast(camOrigin, targetPart.Position - camOrigin, params)
  local camClear = (not camResult) or (camResult.Instance and camResult.Instance:IsDescendantOf(character))

  local rootClear = true
  if localRoot then
    local rootOrigin = localRoot.Position
    local rootResult = workspace:Raycast(rootOrigin, targetPart.Position - rootOrigin, params)
    rootClear = (not rootResult) or (rootResult.Instance and rootResult.Instance:IsDescendantOf(character))
  end

  return camClear and rootClear
end

local function new(class, props, parent)
  local inst = Instance.new(class)
  for k, v in pairs(props) do
    inst[k] = v
  end
  inst.Parent = parent
  return inst
end

local function round(inst, radius)
  return new("UICorner", {CornerRadius = UDim.new(0, radius)}, inst)
end

local function stroke(inst, color, transparency, thickness)
  return new("UIStroke", {
    Color = color or Theme.Stroke,
    Thickness = thickness or 1,
    Transparency = transparency or 0,
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border
  }, inst)
end

