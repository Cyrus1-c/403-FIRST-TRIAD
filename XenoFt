local function findBlasterClass()
    local function isClass(t)
        return type(t) == "table"
            and type(rawget(t, "shoot")) == "function"
            and (type(rawget(t, "startShooting")) == "function" or type(rawget(t, "getSecondsPerShot")) == "function")
    end

    local folder = ReplicatedStorage:FindFirstChild("Blaster")
    if folder then
        local list = {folder}
        for _, d in ipairs(folder:GetDescendants()) do
            table.insert(list, d)
        end
        for _, inst in ipairs(list) do
            if inst:IsA("ModuleScript") then
                local ok, mod = pcall(require, inst)
                if ok and isClass(mod) then
                    return mod
                end
            end
        end
    end

    if getgc then
        local ok, gc = pcall(getgc, true)
        if ok and type(gc) == "table" then
            for _, v in ipairs(gc) do
                if isClass(v) then
                    return v
                end
            end
        end
    end
    return nil
end

