                if self.startAutoFireWhileHeld then
                    self:startAutoFireWhileHeld(FIRE_RATE_INTERVAL)
                elseif origStartShooting then
                    origStartShooting(self, ...)
                end
            end
            return
        end
        if origStartShooting then
            return origStartShooting(self, ...)
        end
    end

    local origRecoil = obj.recoil
    obj.recoil = function(self, ...)
        if Config.NoRecoil then
